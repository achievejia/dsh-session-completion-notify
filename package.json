{
  "name": "dsh-session-completion-notify",
  "version": "1.4.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "macOS native notifications after a DSH session response completes, without reading conversation text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achievejia/dsh-session-completion-notify.git"
  },
  "homepage": "https://github.com/achievejia/dsh-session-completion-notify#readme",
  "bugs": {
    "url": "https://github.com/achievejia/dsh-session-completion-notify/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "macos", "notifications", "cordis"],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "core.js", "preview.js", "native.js", "applet.js", "swift-notify.swift", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": { "test": "node --test test-*.mjs", "check": "node --check index.js && node --check core.js && node --check preview.js && node --check native.js && node --check applet.js" },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
